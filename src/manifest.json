{
  "manifest_version": 3,
  "name": "Quick Snippets for Thunderbird",
  "short_name": "Quick Snippets",
  "version": "1.0.0",
  "author": "King AI",
  "description": "Type a shortcut like ;sig and press Space or Tab in a message you are writing to insert a saved snippet. Pro adds unlimited snippets and {name}, {date}, {time}. Local only.",
  "homepage_url": "https://github.com/kingworks-dev/snippets-for-thunderbird",
  "permissions": ["storage", "compose"],
  "background": {"scripts": ["background.js"]},
  "compose_action": {"default_popup": "popup.html", "default_title": "Quick Snippets",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "browser_specific_settings": {"gecko": {"id": "quick-snippets@usekingai.com", "strict_min_version": "140.0",
    "data_collection_permissions": {"required": ["none"]}}}
}
